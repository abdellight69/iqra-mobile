{
  "expo": {
    "name": "Eqra",
    "slug": "eqra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eqra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.eqra.mobile",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.eqra.mobile"
        ]
      },
      "appleTeamId": "8TSDHC2926"
    },
    "android": {
      "package": "app.eqra.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0F5F4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Eqra écoute votre récitation pour repérer les mots oubliés. L’enregistrement est envoyé au serveur pour analyse, puis supprimé.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F5F4D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-sharing",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "EqraToday",
              "label": "Eqra · Aujourd’hui",
              "description": "Objectif du jour, série, révisions et reprise de lecture.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
