# URL de l'API Eqra (backend). Sur un téléphone physique, utilisez l'IP locale de votre ordinateur,
# par ex. http://192.168.1.20:4000 ; sur l'émulateur Android : http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Abonnement « Soutien » (iqra-backend/docs/soutien-v1.md) : clés SDK publiques RevenueCat
# (Project settings > API keys). Absentes : l'abonnement n'apparaît pas dans l'app.
# La clé du Test Store (test_…) permet d'essayer un achat sans App Store Connect.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Site public (pages conditions/ et confidentialite/) ; par défaut, l'hôte de l'API.
# EXPO_PUBLIC_SITE_URL=
